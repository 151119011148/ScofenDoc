[Unit]
Description=Light Doc Backend (Spring Boot, port 8081)
After=network-online.target mysqld.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lightdoc/app
EnvironmentFile=/opt/lightdoc/app/backend.env
ExecStart=/usr/lib/jvm/java-17-openjdk-17.0.20.0.8-1.1.0.2.1.al8.x86_64/bin/java \
  -Xms128m -Xmx320m -XX:MaxMetaspaceSize=192m -XX:+UseSerialGC \
  -Duser.timezone=Asia/Shanghai \
  -jar /opt/lightdoc/app/light-doc-backend.jar
SuccessExitStatus=143
Restart=always
RestartSec=5
# 小内存机器防止 OOM 时拖垮同机其它服务
MemoryMax=700M

[Install]
WantedBy=multi-user.target
