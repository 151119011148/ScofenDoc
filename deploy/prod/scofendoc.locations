# ============================================================================
# scofendoc.locations —— scofenDoc 协同文档的 Nginx 片段
#
# 该文件不是独立 server 块（不被 conf.d/*.conf 通配加载），
# 而是通过 emotion-web.conf 中的 include 引入到已有的 80 端口 server 内。
# 这样：不改动现有站点根路径、不新增监听端口、不需要改安全组。
#
# 访问入口：http://<IP>/scofendoc/
# ============================================================================

# 省略尾斜杠时补上，保证相对路径解析正确
location = /scofendoc {
    return 301 /scofendoc/;
}

# 前端静态资源（Vite 构建时 base=/scofendoc/）
location /scofendoc/ {
    root /var/www;
    try_files $uri $uri/ /scofendoc/index.html;
}


# 存档文章配图（离线存档导入时落地，不进前端 dist —— 否则每次发版 --delete 会清掉）
location /scofendoc/files/ {
    alias /var/www/scofendoc-files/;
    expires 7d;
    add_header Cache-Control "public, max-age=604800";
}

# 带 hash 的产物可长缓存
location /scofendoc/assets/ {
    root /var/www;
    expires 7d;
    add_header Cache-Control "public, max-age=604800";
}

# 入口 HTML 不缓存，避免发版后拿到旧入口
location = /scofendoc/index.html {
    root /var/www;
    add_header Cache-Control "no-store";
}

# Java 后端：/scofendoc/api/xxx -> 127.0.0.1:8081/api/xxx（剥掉前缀）
location /scofendoc/api/ {
    proxy_pass          http://127.0.0.1:8081/api/;
    proxy_http_version  1.1;
    proxy_set_header    Host              $host;
    proxy_set_header    X-Real-IP         $remote_addr;
    proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header    X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout    30s;
}

# Yjs 协同：WebSocket 升级 + 长连接（read_timeout 必须放大，否则空闲即断）
#
# 注意：Hocuspocus v2 的文档名走协议消息，不走 URL 路径，
# 客户端固定连 /scofendoc/collab 这个端点。
# 而 Nginx 对以 / 结尾的 prefix location 会把 /scofendoc/collab 301 到 /scofendoc/collab/，
# WebSocket 客户端不跟随 301，因此这里用精确匹配兜住不带斜杠的形式。
location = /scofendoc/collab {
    proxy_pass          http://127.0.0.1:1234/;
    proxy_http_version  1.1;
    proxy_set_header    Upgrade           $http_upgrade;
    proxy_set_header    Connection        "upgrade";
    proxy_set_header    Host              $host;
    proxy_set_header    X-Real-IP         $remote_addr;
    proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_connect_timeout 5s;
    proxy_send_timeout    3600s;
    proxy_read_timeout    3600s;
}

location /scofendoc/collab/ {
    proxy_pass          http://127.0.0.1:1234/;
    proxy_http_version  1.1;
    proxy_set_header    Upgrade           $http_upgrade;
    proxy_set_header    Connection        "upgrade";
    proxy_set_header    Host              $host;
    proxy_set_header    X-Real-IP         $remote_addr;
    proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_connect_timeout 5s;
    proxy_send_timeout    3600s;
    proxy_read_timeout    3600s;
}

# ----------------------------------------------------------------------------
# 旧路径兼容：/lightdoc/ → /scofendoc/
# 产品更名后保留旧地址，避免历史书签/收藏夹 404。
# WebSocket 端点不在此重定向（客户端不跟随 301），新版本前端已改用新地址。
# ----------------------------------------------------------------------------
location = /lightdoc {
    return 301 /scofendoc/;
}

location /lightdoc/ {
    rewrite ^/lightdoc/(.*)$ /scofendoc/$1 permanent;
}
